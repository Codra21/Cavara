{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = development: Worker cavara-web-dev, D1 cavara-dev.
  // `bun run dev` uses this config. The DB binding is remote, so local dev reads and writes the real cavara-dev.
  "name": "cavara-web-dev",
  "account_id": "7b55798e5a2b91035dece6c8411564e4",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cavara-dev",
      "database_id": "ad9a1584-6a86-4b2f-bad6-752dd0b3944a",
      "migrations_dir": "migrations",
      "remote": true,
    },
  ],
  // Product images. Served by the Worker at /media/<key> unless the IMAGE_BASE_URL var points at the bucket's
  // custom domain (e.g. https://images.cavarabd.com), which then serves them without Worker requests.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "cavara-images-dev",
      "remote": true,
    },
  ],
  "env": {
    // Selected with CLOUDFLARE_ENV=production at build time (Cloudflare Vite plugin) or --env production (wrangler).
    "production": {
      "name": "cavara-web",
      // Workers Custom Domains: Cloudflare creates the DNS records and certificates on deploy. Each hostname needs
      // its old A/CNAME records (e.g. Vercel's) deleted first; MX and TXT records are left alone.
      "routes": [
        { "pattern": "cavarabd.com", "custom_domain": true },
        { "pattern": "www.cavarabd.com", "custom_domain": true },
      ],
      // The shop is served only on cavarabd.com; no *.workers.dev address or preview URLs for production.
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cavara-prod",
          "database_id": "67ebf200-8a0d-4a00-b932-0ced126e9856",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "cavara-images-prod",
        },
      ],
    },
  },
}

# Loaded by `bun run dev` (Vite mode "development"). Public values only; Vite exposes every VITE_* variable to the browser.
# Cloudflare's dummy Turnstile site key: invisible, always passes, works on any host including localhost. Pair it with
# the dummy secret in .dev.vars. https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB

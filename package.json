{
  "name": "cavara",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "bun check --no-script",
    "test": "bun test",
    "check": "bun run --parallel typecheck test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cf-typegen": "wrangler types",
    "deploy": "bun run check && bun run build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxfmt": "^0.76.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "packageManager": "bun@1.4.4"
}

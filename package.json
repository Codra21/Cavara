{
  "name": "cavara",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "bun check --no-script",
    "test": "bun test",
    "check": "bun run --parallel typecheck test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cf-typegen": "wrangler types",
    "deploy": "bun run check && bun run build:prod && wrangler deploy",
    "seed:generate": "bun scripts/seed/generate-catalog-seed.ts",
    "db:migrate:dev": "wrangler d1 migrations apply cavara-dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply cavara-prod --remote --env production",
    "db:release:prod": "bun scripts/db/migrate-prod.ts",
    "db:backup:prod": "bun scripts/db/migrate-prod.ts --backup-only",
    "build:prod": "CLOUDFLARE_ENV=production vite build",
    "deploy:dev": "bun run check && bun run build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxfmt": "^0.76.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "packageManager": "bun@1.4.4"
}
